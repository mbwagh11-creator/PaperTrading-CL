# Database Configuration
# Local SQLite (default for development):
DATABASE_URL="file:./dev.db"
# For production free hosting (Supabase / Neon PostgreSQL):
# DATABASE_URL="postgresql://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres?pgbouncer=true"

# ---- Upstox API (Live NSE Options & Stock Market Data) ----
# Create a free Upstox developer account: https://upstox.com/developer/apps
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/api/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=

# ---- Razorpay Payment Gateway ----
# Sign up at https://dashboard.razorpay.com/#/app/keys to get API Keys:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ---- Website Mobile App Download Config ----
# Direct APK Download URL (or leave blank to use /downloads/pro-trader.apk)
NEXT_PUBLIC_APK_DOWNLOAD_URL=
